# Hosted demo surface.
#
# Split from the service image deliberately: the front end needs a real build step (`next build`
# emits a static export into `web/ui/out`), and folding that into the shared image would make the
# service rebuild a UI it never serves. The service keeps `Dockerfile`; this file is the web app's.
#
# The Express layer still runs through tsx for the same reason the service does — it imports
# workspace packages by source, and compiling every one of them buys nothing here.
FROM node:24-slim

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# Manifests first so a dependency install is cached independently of source edits.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/ens-config/package.json  packages/ens-config/
COPY packages/x402-client/package.json packages/x402-client/
COPY packages/devnet/package.json      packages/devnet/
COPY packages/graph/package.json       packages/graph/
COPY service/package.json              service/
COPY agent/package.json                agent/
COPY web/package.json                  web/
COPY web/ui/package.json               web/ui/

RUN pnpm install --frozen-lockfile

COPY packages/    packages/
COPY service/     service/
COPY agent/       agent/
COPY web/         web/
COPY deployments/ deployments/
COPY docs/        docs/

# `web/ui/block` holds the Aceternity blocks as the registry ships them — vendor reference, carrying
# their own demo copy and written against React 18 ref types. `web/ui/tsconfig.json` excludes the
# directory; this asserts it, so the image build fails loudly rather than silently shipping them.
RUN test "$(node -e "console.log(JSON.parse(require('fs').readFileSync('web/ui/tsconfig.json','utf8')).exclude.includes('block'))")" = "true" \
  || (echo "web/ui/tsconfig.json no longer excludes block/" && exit 1)

RUN pnpm --filter @tollgate/web-ui build

ENV NODE_ENV=production
ENV TOLLGATE_MODE=live
# Railway injects PORT; the server reads it and falls back to 8500 locally.
CMD ["pnpm", "--filter", "@tollgate/web", "exec", "tsx", "src/server.ts"]
