# ─── Hedera (payments) ────────────────────────────────────────────────────────
# Testnet account that RECEIVES payments for a service you operate.
HEDERA_NETWORK=hedera:testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=                      # ECDSA hex — PrivateKey.fromStringECDSA
HEDERA_MIRROR_NODE=https://testnet.mirrornode.hedera.com

HEDERA_EVM_ADDRESS=                       # 0x… alias of the operator account (optional)

# The account that RECEIVES payments is created by `pnpm hedera:setup` and recorded in
# deployments/hedera-testnet.json — account ids are public, so that file is committed.
# It must differ from the payer: an x402 transfer that debits and credits the same account
# nets to zero and fails the facilitator's amount check.

# Blocky402 facilitator. Testnet needs no API key (verified 1 Sept 2026).
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# HCS topic for the payment audit trail. Created by `pnpm hcs:topic`, which also records it in
# deployments/hedera-testnet.json. Set it here to enable auditing; leaving it unset disables it.
HCS_AUDIT_TOPIC_ID=

# ─── ENS (discovery) ──────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_NAME=                          # e.g. tollgate.eth — the parent we control on Sepolia
DEPLOYER_PRIVATE_KEY=                     # Sepolia key that owns the parent name

# ─── The Graph (goods) ────────────────────────────────────────────────────────
# thegraph.com/studio -> API Keys -> Create. Gate 3 is blocked without this.
GRAPH_API_KEY=
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
SUBGRAPH_MCP_URL=https://subgraphs.mcp.thegraph.com/sse

# ─── Agent ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
